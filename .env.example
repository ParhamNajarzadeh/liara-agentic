# ==============================================================================
# Liara Agentic SRE Assistant — Environment Variables Template (.env.example)
# SECURITY NOTICE: NEVER commit real API keys to git! Copy to `.env` locally.
# ==============================================================================

# 1. MetisAI DeepSeek Wrapper (System 2 Reasoning & Tool Calling)
METIS_API_KEY=
METIS_DEEPSEEK_BASE_URL=https://api.metisai.ir/deepseek/v1
METIS_DEEPSEEK_FALLBACK_BASE_URL=https://api.tapsage.com/deepseek/v1
METIS_ANTHROPIC_BASE_URL=https://api.metisai.ir/deepseek/anthropic
# IMPORTANT: Never append [1m] to DeepSeek model names on MetisAI
METIS_PRIMARY_MODEL=deepseek-v4.1-flash
METIS_HEAVY_REASONING_MODEL=deepseek-v4-pro
METIS_SECONDARY_FALLBACK_MODEL=gpt-4o-mini

# 2. System 1 Fast Decision Engine (Jev / Mizan-4B / Kev / Laya)
METIS_TYPESAFE_BASE_URL=https://api.metisai.ir/api/v1/wrapper/typesafe
MIZAN_LOCAL_URL=http://127.0.0.1:8080/v1/systemone
KEV_LOCAL_URL=http://127.0.0.1:8009/v1/systemone
LAYA_ENABLED=true

# 3. Liara PaaS & DNS OpenAPI (v1 & v2)
LIARA_API_TOKEN=
LIARA_API_BASE_URL=https://api.liara.ir
LIARA_DNS_BASE_URL=https://dns-service.liara.ir
LIARA_VIRTUAL_AGENT_IDENTITY=liara-sre-virtual-agent
# Set to false when connecting to live Liara production account
LIARA_SIMULATOR_MODE=true

# 4. Hackathon Credit Guard & Governance Limits
HACKATHON_INITIAL_CREDIT_TOMANS=2000000
SHORT_TTL_SECONDS=3600
CONTEXT_WINDOW_LIMIT_TOKENS=128000
COMPACTION_UTILIZATION_THRESHOLD=0.70
COMPACTION_MAX_TURNS=40
MAX_AUTO_BUILD_HEAL_ATTEMPTS=2
WORKSPACE_DIR=workspace

# 5. Direct Coding Agent Harness Integration (Claude Code / DeepSeek Harness dsh)
# export ANTHROPIC_BASE_URL=https://api.metisai.ir/deepseek/anthropic
# export ANTHROPIC_AUTH_TOKEN=${METIS_API_KEY}
# export ANTHROPIC_MODEL=deepseek-v4.1-flash
# export CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4.1-flash
# export DEEPSEEK_BASE_URL=https://api.metisai.ir/deepseek/v1
# export DEEPSEEK_API_KEY=${METIS_API_KEY}
